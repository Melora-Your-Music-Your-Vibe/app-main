# ==============================================================
#   MELORA BACKEND - ENVIRONMENT CONFIGURATION
#   Follow the setup guide below to fill in each value
# ==============================================================

# ──────────────────────────────────────────────────
# 1. SERVER
# ──────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ──────────────────────────────────────────────────
# 2. SUPABASE POSTGRESQL DATABASE
#    → Go to: https://supabase.com/dashboard
#    → Create a project → Go to Settings → Database
#    → Copy the "Connection string (URI)" under "Connection string" tab
#    → Replace [YOUR-PASSWORD] in the URI with your DB password
# ──────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# ──────────────────────────────────────────────────
# 3. JWT SECRETS (for authentication tokens)
#    → Generate at: https://generate-secret.vercel.app/64
#    → Or run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ──────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# ──────────────────────────────────────────────────
# 4. CLOUDINARY (audio & image storage)
#    → Go to: https://cloudinary.com/console
#    → Sign up free → Dashboard shows all 3 values
# ──────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ──────────────────────────────────────────────────
# 5. GOOGLE OAUTH (Google sign-in)
#    → Go to: https://console.cloud.google.com
#    → Create project → APIs & Services → Credentials
#    → Create OAuth 2.0 Client ID (Web Application)
# ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# ──────────────────────────────────────────────────
# 6. EMAIL / SMTP (for OTP verification)
#    → Go to: https://myaccount.google.com/apppasswords
#    → Generate an "App Password" for Melora
# ──────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password

# ──────────────────────────────────────────────────
# 7. FRONTEND URL
# ──────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173
